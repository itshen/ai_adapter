# AI模型适配器环境变量配置文件
# 复制此文件为 .env 并填入真实的API密钥

# ===========================================
# 文本聊天API密钥
# ===========================================

# Qwen (通义千问)
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-flash

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct

# 腾讯云混元
HUNYUAN_API_KEY=your-hunyuan-api-key-here
HUNYUAN_MODEL=hunyuan-turbos-latest

# Ollama (本地服务)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# LMStudio (本地服务)
LMSTUDIO_HOST=http://localhost:1234
LMSTUDIO_MODEL=local-model

# OpenAI兼容接口 (如SiliconFlow)
OPENAI_COMPATIBLE_API_KEY=your-openai-compatible-api-key-here
OPENAI_COMPATIBLE_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# ===========================================
# 图片生成API密钥
# ===========================================

# 通义万象 (使用DashScope API)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
TONGYI_WANXIANG_MODEL=wan2.2-t2i-flash

# 即梦AI
JIMENG_ACCESS_KEY=your-jimeng-access-key-here
JIMENG_SECRET_KEY=your-jimeng-secret-key-here
JIMENG_MODEL=jimeng_t2i_v40

# ===========================================
# 服务配置
# ===========================================

# FastAPI服务端口
SERVER_PORT=8888

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
